{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "mac",
      "displayName": "macOS clang, Release (core, shared library, CLI, tests)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/mac",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" }
    },
    {
      "name": "mac-debug",
      "inherits": "mac",
      "binaryDir": "${sourceDir}/build/mac-debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "linux",
      "displayName": "Linux, Release (core, shared library, CLI, tests)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    {
      "name": "windows-x86",
      "displayName": "Windows MSVC x86, Release (core, DLLs, CLI, tests)",
      "generator": "Visual Studio 18 2026",
      "architecture": "Win32",
      "binaryDir": "${sourceDir}/build/windows-x86",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "windows-x64",
      "displayName": "Windows MSVC x64, Release (core, DLLs, CLI, tests)",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/windows-x64",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    { "name": "msvc-x86", "hidden": true, "inherits": "windows-x86" },
    { "name": "msvc-x64", "hidden": true, "inherits": "windows-x64" },
    {
      "name": "wasm",
      "displayName": "Emscripten (run as `emcmake cmake --preset wasm`)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/wasm",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    }
  ],
  "buildPresets": [
    { "name": "mac", "configurePreset": "mac" },
    { "name": "mac-debug", "configurePreset": "mac-debug" },
    { "name": "linux", "configurePreset": "linux" },
    { "name": "windows-x86", "configurePreset": "windows-x86", "configuration": "Release" },
    { "name": "windows-x64", "configurePreset": "windows-x64", "configuration": "Release" },
    { "name": "msvc-x86", "hidden": true, "inherits": "windows-x86" },
    { "name": "msvc-x64", "hidden": true, "inherits": "windows-x64" },
    { "name": "wasm", "configurePreset": "wasm" }
  ],
  "testPresets": [
    { "name": "mac", "configurePreset": "mac", "output": { "outputOnFailure": true } },
    { "name": "mac-debug", "configurePreset": "mac-debug", "output": { "outputOnFailure": true } },
    { "name": "linux", "configurePreset": "linux", "output": { "outputOnFailure": true } },
    { "name": "windows-x86", "configurePreset": "windows-x86", "configuration": "Release", "output": { "outputOnFailure": true } },
    { "name": "windows-x64", "configurePreset": "windows-x64", "configuration": "Release", "output": { "outputOnFailure": true } },
    { "name": "msvc-x86", "hidden": true, "inherits": "windows-x86" },
    { "name": "msvc-x64", "hidden": true, "inherits": "windows-x64" }
  ]
}
