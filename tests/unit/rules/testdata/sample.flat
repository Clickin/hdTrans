# Hand-written rules: every operator, connective and literal escape at least once.
rules 1 20 6

L 0 ||0
L 1 ||1 S+0== "あら"
L 2 ||2 S-1!= "Lの" S+0== @+1
L 3 ||2 D+1== "R가" D-1!= ""
L 4 ||1 &&2 P+0== "4**" D+0= "가다"
L 5 ||1 D-1= @+0
L 6 ||1 &&2 P-2!= "1**" A+0== "VMo"
L 7 ||1 &2 A+0!= "QID" A+0-= "VHn"
L 8 ||1 A+0-= @-2
L 9 ||3 G+0== "Ow" G+1!= "Xj" G-1-= "Hd"
L 10 ||1 ||2 U+0== "Lて" U+1!= "た"
L 11 ||1 &&3 Y+0== "1고" M+0== "57*" Y+0= "6서"
L 12 ||1 &&2 Y-1= @+0 T+0== "VHn"
L 13 ||2 T+0-= "VMo" W+0== "Da"
L 14 ||1 W-1!= "Ds"
L 15 ||2 &&3 S+1== "で" D+0= "에서" Y-1= "" S+0== "\x82\xa0"
L 16 ||1 &&2 &2 S+1!= "a" &2 S+1!= "b" S+1!= "c\x82" P+1== "7**"
L 17 ||1 &&2 ||2 S+3== "\"も\\" S-3== "x y" P+0== "5:0"
L 18 ||1 &&3 S+0== "が" ||2 P-1== "1**" P-1== "2**" D+0= " 이"
L 19 ||2 &&2 D+0= "가" D-1= "나" S+0== "다"

G 0 1 1002 1 ||1 &&2 P+0== "1**" D+0= "일"
G 1 1 4999 1 ||1 S+0== "の"
G 2 1 5000 1 ||1 S+0== "を"
G 3 4 2 1 ||1 S+0== "い"
G 4 4 5200 0 ||1 Y+0== "6"
G 5 4 9991 0 ||1 Y+0== "6서"
